@using BookApp.Components.Models
@using BookApp.Components.Services

@inject NavigationManager Navigation
@inject OpenLibraryService OpenLibraryService
@inject WishlistService WishlistService
@inject IJSRuntime JS

@if (IsLoading)
{
    <div class="">
        <strong>Kraunamas knygų sąrašas...</strong>
        <div class="spinner-border text-primary me-2" role="status" aria-hidden="true"></div>
    </div>
}
else if (SelectedAuthor != null && !IsLoading)
{
    <h1>@SelectedAuthor.Name knygos:</h1>
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Pavadinimas</th>
                <th class="text-center">Pirmas leidimas</th>
                <th class="text-center">Veiksmai</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Books)
            {
                <tr>
                    <td class="align-middle">@book.Title</td>
                    <td class="text-center align-middle">@book.FirstPublishYear</td>

                    @if (!string.IsNullOrEmpty(book.Key))
                    {
                        var cleanKey = NormalizeKey(book.Key);
                        var isInWishlist = WishlistKeys.Contains(cleanKey);

                        <td class="align-middle">
                            <div class="d-flex align-items-center">
                                <button class="btn btn-primary btn-sm me-2"
                                        @onclick="() => NavigateToDetails(cleanKey)">
                                    Detaliau
                                </button>

                                @if (isInWishlist)
                                {
                                    <span class="flex-grow-1 text-center text-warning fs-4 bi bi-star-fill"
                                          title="Jau įtraukta"></span>
                                }
                                else
                                {
                                    <button class="btn btn-outline-success btn-sm ms-auto"
                                            @onclick="() => AddToWishlist(book)">
                                        Įtraukti į norų sąrašą
                                    </button>
                                }
                            </div>
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter]
    public Author? SelectedAuthor { get; set; }

    private bool IsLoading = false;
    private List<Book> Books = new();
    private HashSet<string> WishlistKeys = new();
    private string? _prevAuthorKey;

    protected override async Task OnInitializedAsync()
    {
        if (SelectedAuthor?.Key is not null)
        {
            Books = await OpenLibraryService.GetBooksByAuthor(SelectedAuthor.Key);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (SelectedAuthor?.Key is not null && SelectedAuthor.Key != _prevAuthorKey)
        {
            _prevAuthorKey = SelectedAuthor.Key;
            IsLoading = true;

            Books = await OpenLibraryService.GetBooksByAuthor(SelectedAuthor.Key);

            var wishlist = await WishlistService.GetWishlist();
            WishlistKeys = wishlist
                .Where(b => !string.IsNullOrEmpty(b.Key))
                .Select(b => NormalizeKey(b.Key!))
                .ToHashSet();

            IsLoading = false;
        }
    }

    private string NormalizeKey(string key)
        => key.Replace("/works/", "").Trim('/');

    protected void NavigateToDetails(string cleanKey)
        => Navigation.NavigateTo($"/book/{cleanKey}");

    private async Task AddToWishlist(Book book)
    {
        await WishlistService.AddToWishlist(book);
        WishlistKeys.Add(NormalizeKey(book.Key!));
        await JS.InvokeVoidAsync("alert", "Knyga pridėta į norų sąrašą!");
    }
}
