@rendermode InteractiveServer

@page "/"
@using BookApp.Components.Elements
@using BookApp.Components.Models

<SearchableDropdown SelectedAuthorChanged="OnSelectedAuthorChanged" />
<BookList SelectedAuthor="SelectedAuthor" />

@code {
    private Author? SelectedAuthor;

    private void OnSelectedAuthorChanged(Author author)
    {
        SelectedAuthor = author;
    }
}